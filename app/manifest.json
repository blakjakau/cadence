{
  "short_name": "Cadence",
  "name": "Cadence",
  "icons": [
    {
      "src": "/images/code-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/images/code-512.png",
      "type": "image/png",
      "sizes": "512x512"
    }

  ],
  "start_url": "/index.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+cadence",
      "url": "/?start=%s"
    }
  ],
  "scope": "/",
  "theme_color": "#3f51b5",
  "background_color": "#ffffff",
  "description": "Super light code editing in your brower!",
  "screenshots": [
    {
      "src": "images/screen-small-720x540.png",
      "type": "image/png",
      "sizes": "720x540"
    },
    {
      "src": "images/screen-mid-1024x662.png",
      "type": "image/png",
      "sizes": "1024x662",
      "form_factor":"wide"
    }
  ],
  "file_handlers": [
    {
      "action": "/openFile.html",
      "accept": {
        "application/javascript": [".js",".mjs",".jsm",".json"],
        "text/stylesheet": [".css"],
        "text/html": [".html"]
      },
      "icons": [
        {
          "src": "/images/code-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}